<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Inserisci il testo da aggiungere"
        android:textColor="#333333"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"/>

    <EditText
        android:id="@+id/etAnnotationText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Scrivi qui..."
        android:background="@drawable/edittext_background"
        android:padding="12dp"
        android:minLines="3"
        android:inputType="textMultiLine|textCapSentences"
        android:gravity="top"
        android:layout_marginBottom="20dp"/>

    <TextView
        android:id="@+id/tvFontSizePreview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dimensione carattere: 16"
        android:textColor="#666666"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"/>

    <SeekBar
        android:id="@+id/sbFontSize"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="40"
        android:progress="6"
        android:layout_marginBottom="10dp"/>

    <Button
        android:id="@+id/btnChangeColor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cambia Colore"
        android:layout_marginTop="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="(Trascina per cambiare dimensione)"
        android:textSize="11sp"
        android:layout_gravity="center_horizontal"/>

</LinearLayout>
