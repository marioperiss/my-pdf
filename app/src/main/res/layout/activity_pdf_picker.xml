<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F5F5">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Libreria Documenti Recenti (Cartella App)"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:paddingBottom="8dp" />

    <EditText
        android:id="@+id/etSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Cerca documento per nome..."
        android:padding="12dp"
        android:background="@drawable/edittext_background"
        android:layout_marginBottom="8dp"
        android:inputType="text" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnSortName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ordina per Nome"
            android:textSize="12sp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnSortDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ordina per Data"
            android:textSize="12sp"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <ListView
        android:id="@+id/listViewDocs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/darker_gray"
        android:dividerHeight="1dp" />

    <Button
        android:id="@+id/btnPickExternal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📁 Sfoglia file esterni (Altra cartella)"
        android:backgroundTint="#607D8B"
        android:textColor="@android:color/white"
        android:layout_marginTop="12dp"
        android:padding="12dp" />

</LinearLayout>
